# Backend API configuration for Digital Seva Kendra
# Copy this file to .env and adjust values

# Base URL of your backend API.
# When using Vite dev proxy, keep '/api' so requests proxy to VITE_API_PROXY_TARGET.
VITE_API_BASE_URL=/api

# If you have a standalone backend URL (e.g. Laravel/Express/Node), uncomment:
# VITE_API_BASE_URL=https://your-backend.com/api

# Timeout in ms for API requests
VITE_API_TIMEOUT=15000

# Unique site/tenant identifier if your backend serves multiple sites
VITE_SITE_ID=csce-governance

# Set to 'false' to skip all backend calls and use bundled static data
VITE_ENABLE_BACKEND=true

# Target of the dev proxy for /api routes (default: Node/Express backend)
VITE_API_PROXY_TARGET=http://localhost:5000